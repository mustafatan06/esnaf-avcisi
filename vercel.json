{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server.js" },
    { "src": "/demo/(.*)", "dest": "server.js" },
    { "src": "/yonetim-gizli-panel", "dest": "server.js" },
    { "src": "/", "dest": "server.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}